# Arista AP credentials (for challenge-response OTP)
ARISTA_USERNAME=your_arista_username
ARISTA_PASSWORD=your_arista_password

# Google Calendar — handled via Apps Script push (apps_script/CalendarProxy.gs)
# No env var needed — the script pushes to /api/v1/calendar/push

# Slack webhook URL for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Database path (SQLite)
DATABASE_PATH=data/presence.db

# Server config
HOST=0.0.0.0
PORT=8000

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO
